# AI Settings (Google AI Studio)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DEBUG=false

# Optional OpenAI fallback/provider settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Database (Supabase / Neon / PostgreSQL)
# Boş bırakılırsa yerel data/db.json kullanılır. Supabase URI girilirse otomatik PostgreSQL'e geçer.
DATABASE_URL=
DB_DRIVER=postgres

# Notification delivery (log = simulate only, webhook = POST to gateway)
NOTIFY_DRIVER=log
NOTIFY_WEBHOOK_URL=

# Port (Render/Railway bunu otomatik ayarlar)
PORT=4173
